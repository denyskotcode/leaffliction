# --- Datasets & generated artifacts (MUST NOT be committed, per subject) ---
# raw / augmented image datasets
*.jpg
*.jpeg
*.JPG
*.JPEG
*.png
*.PNG
# allow images used only for README/docs, if any (a trailing comment on a
# gitignore line is part of the pattern, so this must sit on its own line)
!docs/**
augmented_directory/
dataset/
datasets/
Apple/
Grape/
data/

# the raw data set: leaves.zip and everywhere it gets unpacked
leaves.zip
leaves/
images/

# release artifacts (zip is forbidden in git; signature.txt is the only
# allowed trace of it, and even that should be regenerated, not hand-edited)
dataset.zip
learnings.zip
*.zip

# trained model files
*.h5
*.pt
*.pth
*.keras
*.pkl
*.joblib
models/

# train.py staging dir for the learnings.zip payload, and the figure
# predict.py writes when no display is available
learnings/
prediction.png

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# venvs (in case someone on the team does use one)
.venv/
venv/
venvzip/
env/

# --- Editors / OS junk ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Logs / caches ---
*.log
.cache/
.pytest_cache/
.mypy_cache/
.flake8_cache/
